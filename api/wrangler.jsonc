{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "coney-arcade-leaderboards",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "leaderboards.coneyislandpottsville.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coney-arcade-leaderboards",
      "database_id": "f1de8fff-22fe-4a42-9e1f-25ef0f92387e",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "VALIDATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
