{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaderboards.coneyislandpottsville.com/schema/game.json",
  "title": "Coney arcade leaderboard game",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "listed", "board", "clients", "origins", "initials", "fields", "ranking", "columns"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "listed": { "type": "boolean" },
    "board": { "type": "integer", "minimum": 1, "maximum": 100 },
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" }
    },
    "origins": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://[a-z0-9.-]+$|^http://localhost(:[0-9]{1,5})?$" }
    },
    "initials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": { "default": { "type": "string", "pattern": "^[A-Z0-9]{1,3}$" } }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]{0,31}$",
        "not": { "enum": ["initials", "client", "submissionId", "rank", "id", "submittedAt", "game"] }
      },
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "ranking": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/component" } },
    "columns": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/column" } }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["integer", "decimal"] },
        "required": { "type": "boolean", "default": false },
        "min": { "type": "number" },
        "max": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "factor"],
              "properties": {
                "field": { "type": "string" },
                "factor": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          ]
        },
        "step": { "type": "integer", "minimum": 1 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 6 },
        "onInvalid": { "enum": ["unknown", "reject"], "default": "reject" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "decimal" } } }, "then": { "required": ["precision"] } },
        { "if": { "properties": { "type": { "const": "integer" } } }, "then": { "not": { "required": ["precision"] } } },
        { "if": { "properties": { "type": { "const": "decimal" } } }, "then": { "not": { "required": ["step"] } } }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "order"],
      "properties": {
        "field": { "type": "string" },
        "order": { "enum": ["asc", "desc"] },
        "unknown": { "enum": ["first", "last"], "default": "last" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "label"],
      "properties": {
        "field": { "type": "string" },
        "label": { "type": "string", "minLength": 1, "maxLength": 16 },
        "format": { "enum": ["integer", "decimal", "duration"], "default": "integer" }
      }
    }
  }
}
